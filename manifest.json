{
  "manifest_version": 3,
  "name": "Steam Guide Enhancer",
  "version": "1.4.0",
  "description": "Checkboxes, notes, drawing and resume-where-you-left-off for Steam Community guides. Saved locally, even after a restart.",
  "homepage_url": "https://github.com/DiogoAlmMarques/steam-guide-enhancer",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/sharedfiles/filedetails/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
